# Copy to .env (gitignored) or export these before running scripts/signal3_github.py.

# Read-only GitHub token (public_repo scope is enough). Optional but close to required at
# any volume: unauthenticated GitHub allows 60 requests an hour, a token allows 5,000.
GITHUB_TOKEN=

# Paths. All optional - they default to data/seed.csv and results/signal-github.json
# relative to the repo.
SEED_CSV=
OUTPUT_JSON=

# Optional. Stamps the scan with a date other than today, for backfills.
SCAN_DATE=
